# ─────────────────────────────────────────────────────────────────────────────
# Ember & Saffron — settings. Copy to `.env.local` (development) or set these in
# your hosting provider's "Environment variables" screen (production).
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the website. Used for the sitemap, social-media previews and
# Google. Must be set BEFORE `npm run build` (it is baked into the pages).
NEXT_PUBLIC_SITE_URL=https://www.your-restaurant.com

# Manager dashboard (/admin) password. In production it must be at least 10
# characters and not the demo password, otherwise the dashboard stays locked.
ADMIN_PASSWORD=change-me-to-a-long-secret

# Optional: separate secret for signing login cookies (32+ random characters).
# If empty, one is derived from ADMIN_PASSWORD (changing the password logs everyone out).
ADMIN_SESSION_SECRET=

# Database. Leave empty to store data in ./data/db.json (fine for one server with
# a persistent disk). REQUIRED on Vercel / serverless hosting.
# Example (Neon/Supabase/Railway): postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Optional: max database connections per server instance (default 10, or 1 on Vercel).
# DATABASE_POOL_SIZE=10

# Showcase (demo) mode is ON by default: orders, bookings, enquiries and newsletter sign-ups show a
# confirmation but nothing is stored, and /admin shows sample data. No database is needed.
# Set to false to store real data (then configure DATABASE_URL or use data/db.json).
# SHOWCASE_MODE=false
